# ===== PDF 工具箱：環境變數範本 =====
# 複製為 .env 後修改。切勿把 .env 提交到版本庫。
# 產生隨機機密：  openssl rand -base64 48

# --- 必填 ---
POSTGRES_PASSWORD=CHANGE_ME
# JWT 簽章金鑰（≥32 字元）
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
# 資料庫敏感欄位（TOTP secret）的 AES-256-GCM 金鑰來源（≥32 字元）。遺失會導致 2FA 無法解密！請備份。
APP_ENC_KEY=CHANGE_ME_openssl_rand_base64_48

# --- 預設管理者帳號（容器啟動時自動建立/更新） ---
ADMIN_USERNAME=qiyen
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- 網站 ---
HOST_PORT=9133
# 使用者實際開啟的網址（郵件中的連結會用到）
PUBLIC_URL=https://pdf.example.com
# 啟用 https 設定檔時使用的網域
DOMAIN=pdf.example.com

# --- HTTPS / Cookie ---
# 在反向代理（HTTPS）後方：true。僅在區網以 http:// 測試時才可設 false（不安全）。
COOKIE_SECURE=true
# 由應用程式強制 http→https 並送出 HSTS（反向代理已處理時可維持 false）
FORCE_HTTPS=false
# 反向代理層數（NAS 反向代理 / caddy = 1）
TRUST_PROXY=1

# --- 管理後台 ---
# 逗號分隔的 IP / CIDR 白名單，留空 = 不限制。例：192.168.1.0/24,10.0.0.5
ADMIN_IP_ALLOWLIST=

# --- 郵件（註冊驗證 / 忘記密碼）。未設定則停用郵件驗證 ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PDF 工具箱 <no-reply@example.com>

# --- 告警（選填）：異常登入、帳號鎖定、速率限制會 POST 到此 Webhook（Slack/Discord/自建） ---
ALERT_WEBHOOK_URL=

# --- 其他 ---
LOG_LEVEL=info
REFRESH_TTL_DAYS=7
